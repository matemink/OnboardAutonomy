<?xml version="1.0"?>
<sdf version="1.9">
  <model name="lightweight_grass_ground">
    <static>true</static>
    <link name="ground_link">
      <collision name="ground_collision">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>200 200</size>
          </plane>
        </geometry>
      </collision>
      <visual name="ground_visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>meshes/ground.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <pbr>
            <metal>
              <albedo_map>materials/textures/Grass004_1K-JPG_Color.jpg</albedo_map>
              <roughness>0.9</roughness>
              <metalness>0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
