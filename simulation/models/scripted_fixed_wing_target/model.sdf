<?xml version="1.0"?>
<sdf version="1.9">
  <model name="scripted_fixed_wing_target">
    <pose>0 -12 8 0 0 0</pose>
    <enable_wind>false</enable_wind>

    <link name="airframe">
      <gravity>false</gravity>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.9</ixx>
          <iyy>0.7</iyy>
          <izz>1.5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="airframe_collision">
        <geometry>
          <box>
            <size>2.2 2.8 0.35</size>
          </box>
        </geometry>
      </collision>

      <visual name="fuselage">
        <pose>0 0 0 0 1.5707963267948966 0</pose>
        <geometry>
          <cylinder>
            <radius>0.18</radius>
            <length>2.4</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.9 0.22 0.05 1</ambient>
          <diffuse>1.0 0.32 0.08 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>

      <visual name="main_wing">
        <pose>-0.1 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.65 3.2 0.10</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.12 0.25 1</ambient>
          <diffuse>0.08 0.22 0.55 1</diffuse>
        </material>
      </visual>

      <visual name="horizontal_tail">
        <pose>-1.0 0 0.08 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 1.25 0.07</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.12 0.25 1</ambient>
          <diffuse>0.08 0.22 0.55 1</diffuse>
        </material>
      </visual>

      <visual name="vertical_tail">
        <pose>-1.0 0 0.30 0 0 0</pose>
        <geometry>
          <box>
            <size>0.45 0.07 0.65</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.22 0.05 1</ambient>
          <diffuse>1.0 0.32 0.08 1</diffuse>
        </material>
      </visual>

      <visual name="nose_marker">
        <pose>1.25 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.23</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.95 0.75 0.05 1</ambient>
          <diffuse>1.0 0.85 0.08 1</diffuse>
        </material>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <initial_linear>2 0 0</initial_linear>
      <initial_angular>0 0 0.1666666666666667</initial_angular>
    </plugin>
  </model>
</sdf>
