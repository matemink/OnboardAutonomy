<?xml version="1.0"?>
<sdf version="1.9">
  <model name="scripted_fixed_wing_target">
    <pose>0 -15 12 0 0 0</pose>
    <enable_wind>false</enable_wind>

    <link name="airframe">
      <gravity>false</gravity>
      <inertial>
        <mass>2.5</mass>
        <inertia>
          <ixx>0.9</ixx>
          <iyy>0.7</iyy>
          <izz>1.5</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="airframe_collision">
        <geometry>
          <box>
            <size>3.5 2.5 0.5</size>
          </box>
        </geometry>
      </collision>

      <visual name="shahed_136_airframe">
        <!-- The imported FBX nose points along -Y; map -Y to Gazebo +X. -->
        <pose>-1.328877220 0 -0.193101322 0 0 1.5707963267948966</pose>
        <geometry>
          <mesh>
            <uri>meshes/shahed_136/scene.gltf</uri>
            <!-- Local X/Y/Z map to span/height/length after the visual rotation. -->
            <scale>1.422263684 1.356554469 1.453943853</scale>
          </mesh>
        </geometry>
      </visual>
    </link>

    <plugin filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <initial_linear>12 0 0</initial_linear>
      <initial_angular>0 0 0.8</initial_angular>
    </plugin>
  </model>
</sdf>
