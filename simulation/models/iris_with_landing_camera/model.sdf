<?xml version="1.0"?>
<sdf version="1.9">
  <model name="holybro_s500_development_rig">
    <enable_wind>true</enable_wind>

    <include>
      <uri>model://iris_with_gimbal</uri>
      <name>vehicle</name>
    </include>

    <link name="Pixhawk_6C">
      <pose relative_to="vehicle::iris_with_standoffs::base_link">
        0 0 0.055 0 0 0
      </pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00003</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="Pixhawk_6C_body">
        <geometry>
          <box>
            <size>0.084 0.044 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
        </material>
      </visual>

      <sensor name="Pixhawk_6C_barometer" type="air_pressure">
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <topic>/onboard_autonomy/sensors/pixhawk_6c/air_pressure</topic>
        <air_pressure>
          <reference_altitude>584</reference_altitude>
          <pressure>
            <noise type="gaussian">
              <mean>0</mean>
              <stddev>2.3</stddev>
            </noise>
          </pressure>
        </air_pressure>
      </sensor>
    </link>

    <link name="Raspberry_Pi_5">
      <pose relative_to="vehicle::iris_with_standoffs::base_link">
        0.095 0 0.055 0 0 0
      </pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.00002</ixx>
          <iyy>0.00003</iyy>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="Raspberry_Pi_5_board">
        <geometry>
          <box>
            <size>0.085 0.056 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.25 0.12 1</ambient>
          <diffuse>0.07 0.42 0.20 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="Raspberry_Pi_Camera_Module_3_Wide">
      <pose relative_to="vehicle::iris_with_standoffs::base_link">
        0 0 -0.14 0 0 0
      </pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="Raspberry_Pi_Camera_Module_3_Wide_body">
        <geometry>
          <box>
            <size>0.05 0.05 0.03</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.12 0.14 1</ambient>
          <diffuse>0.05 0.12 0.14 1</diffuse>
        </material>
      </visual>

      <!-- Gazebo cameras look along sensor +X; +90 deg pitch points it down. -->
      <sensor name="Raspberry_Pi_Camera_Module_3_Wide" type="camera">
        <pose>0 0 -0.02 0 1.5707963267948966 0</pose>
        <camera>
          <horizontal_fov>2.0</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
        </camera>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <plugin name="GstCameraPlugin" filename="GstCameraPlugin">
          <udp_host>127.0.0.1</udp_host>
          <udp_port>5601</udp_port>
          <use_basic_pipeline>true</use_basic_pipeline>
          <use_cuda>false</use_cuda>
        </plugin>
      </sensor>
    </link>

    <joint name="Pixhawk_6C_mount" type="fixed">
      <parent>vehicle::iris_with_standoffs::base_link</parent>
      <child>Pixhawk_6C</child>
    </joint>

    <joint name="Raspberry_Pi_5_mount" type="fixed">
      <parent>vehicle::iris_with_standoffs::base_link</parent>
      <child>Raspberry_Pi_5</child>
    </joint>

    <joint name="Raspberry_Pi_Camera_Module_3_Wide_mount" type="fixed">
      <parent>vehicle::iris_with_standoffs::base_link</parent>
      <child>Raspberry_Pi_Camera_Module_3_Wide</child>
    </joint>
  </model>
</sdf>
