# The launcher auto-discovers one Pixhawk USB/UART device. Set an exact path
# when more than one candidate exists.
# ONBOARD_AUTONOMY_SERIAL=/dev/serial/by-id/usb-ArduPilot_Pixhawk6C_...
ONBOARD_AUTONOMY_BAUD=115200

ONBOARD_AUTONOMY_CAMERA_ENABLED=1
ONBOARD_AUTONOMY_CAMERA_WIDTH=640
ONBOARD_AUTONOMY_CAMERA_HEIGHT=480
ONBOARD_AUTONOMY_CAMERA_FPS=30
ONBOARD_AUTONOMY_CAMERA_PREVIEW_ENABLED=1
ONBOARD_AUTONOMY_CAMERA_PREVIEW_PORT=8080

# Metric pose remains disabled until a measured target span is supplied.

ONBOARD_AUTONOMY_LOG_MAX_FILES=20
ONBOARD_AUTONOMY_LOG_MAX_TOTAL_BYTES=104857600
ONBOARD_AUTONOMY_LOG_MAX_FILE_BYTES=10485760
