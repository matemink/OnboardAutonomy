compilation_database_dir: ${HOME}/build/onboard_autonomy-uml
output_directory: docs/diagrams/generated
generate_method_arguments: none
include_relations_also_as_members: false

diagrams:
  architecture_packages:
    type: package
    glob:
      - src/bootstrap/RuntimeAssembly.cpp
      - src/application/CompanionApplication.cpp
    using_namespace: onboard_autonomy
    include:
      namespaces:
        - onboard_autonomy

  autonomy_core:
    type: class
    glob:
      - src/application/CompanionApplication.cpp
      - src/application/AutonomyRuntime.cpp
    using_namespace: onboard_autonomy
    include:
      context:
        - match:
            radius: 2
            pattern: onboard_autonomy::application::CompanionApplication
    exclude:
      access:
        - private

  runtime_wiring:
    type: class
    glob:
      - src/bootstrap/RuntimeAssembly.cpp
    using_namespace: onboard_autonomy
    include:
      context:
        - match:
            radius: 2
            pattern: onboard_autonomy::bootstrap::RuntimeAssembly
    exclude:
      access:
        - private
